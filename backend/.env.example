# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
# Plain KEY=value lines (no quotes, no spaces around '=').

# --- PostgreSQL (required) ---
# Neon: use the DIRECT endpoint (not the "-pooler" host); the app pools connections itself with HikariCP.
DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<username>
DB_PASSWORD=<password>
DB_POOL_SIZE=10

# Only for the optional throwaway local PostgreSQL (docker compose --profile local-db):
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST_PORT=5433

# --- Backend ---
SERVER_PORT=8080
# Optional: "demo" seeds sample data, "local" allows an ephemeral JWT secret
SPRING_PROFILES_ACTIVE=
# At least 32 bytes, e.g. generate with: openssl rand -base64 48
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
APP_CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]
APP_TIME_ZONE=UTC

# --- AI provider (optional; the app works without it) ---
# none | anthropic
APP_AI_PROVIDER=none
APP_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
